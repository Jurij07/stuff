# ===========================================================================
# POE2 ENDGAME STRICT LOOT FILTER
# Version: 1.2  |  Schwierigkeit: Strikt (Endgame)
# Optimiert fuer: Endgame-Farming, hohe Waystone-Tier-Gebiete
#
# WICHTIG - PoE2 Klassen-Namen (verifiziert gegen NeverSink PoE2):
#   - Currency/Orbs/Essences/Omens/Splinter = Class "Stackable Currency"
#   - Gems (Skill + Support)                 = Class "Gems"
#   - Jewels                                  = Class "Jewels"
#   - Waystones                               = Class "Waystones"
#   - Runes                                   = Class "Runes"
#   - Soul Cores                              = Class "Soul Cores"
#   - Charms                                  = Class "Charms"
#   - Rings                                   = Class "Rings"
#   - Tablets                                 = Class "Tablet"
#   Spezial-Items werden ueber BaseType erkannt (klassen-unabhaengig,
#   robust gegen Patch-Aenderungen).
#
# FARBCODE:
#   Rot         = Mirror-Tier / Ultra-Selten
#   Gold/Gelb   = Top-Currency (Divine, Exalted, Perfect Jeweller's)
#   Orange      = Hohe/Mittlere Currency
#   Pink        = Essences / Omens
#   Tuerkis     = Waystones / Tablets
#   Gruen       = Gems (Uncut + Quality)
#   Braun       = Unique Items
#   Lila        = Runes / Soul Cores
#   Blau        = Distilled Emotions (Delirium)
#   Gelb (rand) = Rare Items (hohe ilvl)
# ===========================================================================


# ===========================================================================
# ABSCHNITT 1: MIRROR TIER  (Extrem selten)
# ===========================================================================

Show
    BaseType "Mirror of Kalandra" "Mirror Shard"
    SetTextColor 255 0 0 255
    SetBackgroundColor 0 0 0 255
    SetBorderColor 255 0 0 255
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Red Star
    PlayEffect Red


# ===========================================================================
# ABSCHNITT 2: TOP CURRENCY  (Divine / Exalted / Perfect Jeweller's)
# ===========================================================================

Show
    BaseType "Divine Orb" "Perfect Jeweller's Orb"
    SetTextColor 255 215 0 255
    SetBackgroundColor 60 40 0 255
    SetBorderColor 255 200 0 255
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Yellow Star
    PlayEffect Yellow

Show
    BaseType "Exalted Orb"
    SetTextColor 255 210 0 255
    SetBackgroundColor 50 30 0 255
    SetBorderColor 220 175 0 255
    SetFontSize 43
    PlayAlertSound 1 300
    MinimapIcon 0 Yellow Star
    PlayEffect Yellow


# ===========================================================================
# ABSCHNITT 3: HOHE CURRENCY
# ===========================================================================

Show
    BaseType "Chaos Orb" "Orb of Annulment" "Vaal Orb" "Fracturing Orb" "Gemcutter's Prism" "Greater Jeweller's Orb"
    SetTextColor 255 165 0 255
    SetBackgroundColor 50 15 0 255
    SetBorderColor 220 130 0 255
    SetFontSize 40
    PlayAlertSound 2 300
    MinimapIcon 1 Orange Diamond
    PlayEffect Orange


# ===========================================================================
# ABSCHNITT 4: MITTLERE CURRENCY
# ===========================================================================

Show
    BaseType "Regal Orb" "Orb of Alchemy" "Orb of Chance" "Lesser Jeweller's Orb" "Artificer's Orb" "Arcanist's Etcher"
    SetTextColor 230 180 70 255
    SetBackgroundColor 40 25 0 220
    SetBorderColor 180 130 50 220
    SetFontSize 36
    PlayAlertSound 3 220
    MinimapIcon 2 Yellow Circle


# ===========================================================================
# ABSCHNITT 5: ESSENCES  (Class "Stackable Currency", per BaseType erkannt)
# ===========================================================================

Show
    BaseType "Essence"
    SetTextColor 255 100 255 255
    SetBackgroundColor 60 0 65 225
    SetBorderColor 225 0 225 255
    SetFontSize 39
    PlayAlertSound 3 225
    MinimapIcon 0 Pink Diamond
    PlayEffect Pink


# ===========================================================================
# ABSCHNITT 6: OMENS  (Ritual, wertvoll)
# ===========================================================================

Show
    BaseType "Omen of"
    SetTextColor 255 140 200 255
    SetBackgroundColor 55 10 35 225
    SetBorderColor 230 90 160 255
    SetFontSize 39
    PlayAlertSound 3 220
    MinimapIcon 0 Pink Star
    PlayEffect Pink


# ===========================================================================
# ABSCHNITT 7: BREACH SPLITTER / BREACHSTONES / FRAGMENTE
# ===========================================================================

Show
    BaseType "Breachstone"
    SetTextColor 255 120 0 255
    SetBackgroundColor 55 15 0 220
    SetBorderColor 220 80 0 255
    SetFontSize 38
    PlayAlertSound 2 220
    MinimapIcon 1 Orange Star
    PlayEffect Orange

Show
    BaseType "Splinter" "Artifact"
    SetTextColor 255 150 0 255
    SetBackgroundColor 45 12 0 200
    SetBorderColor 200 100 0 220
    SetFontSize 32
    MinimapIcon 2 Orange Circle


# ===========================================================================
# ABSCHNITT 8: DISTILLED EMOTIONS  (Delirium)
# ===========================================================================

# Hohe Distilled Emotions
Show
    BaseType "Distilled Despair" "Distilled Fear" "Distilled Guilt" "Distilled Envy" "Distilled Ire" "Distilled Disgust"
    SetTextColor 200 190 255 255
    SetBackgroundColor 25 20 75 225
    SetBorderColor 140 130 255 235
    SetFontSize 37
    PlayAlertSound 3 190
    MinimapIcon 1 Blue Diamond
    PlayEffect Blue

# Alle anderen Distilled (Sicherheitsnetz)
Show
    BaseType "Distilled"
    SetTextColor 160 155 235 230
    SetBackgroundColor 15 12 55 200
    SetBorderColor 105 100 210 205
    SetFontSize 32
    MinimapIcon 2 Blue Circle
    PlayEffect Blue


# ===========================================================================
# ABSCHNITT 9: RUNES  (Class "Runes")
# ===========================================================================

Show
    Class "Runes"
    SetTextColor 200 170 255 255
    SetBackgroundColor 35 0 60 215
    SetBorderColor 160 100 255 235
    SetFontSize 35
    PlayAlertSound 3 180
    MinimapIcon 2 Purple Circle
    PlayEffect Purple


# ===========================================================================
# ABSCHNITT 10: SOUL CORES  (Class "Soul Cores")
# ===========================================================================

Show
    Class "Soul Cores"
    SetTextColor 255 180 255 255
    SetBackgroundColor 60 0 65 235
    SetBorderColor 255 100 255 255
    SetFontSize 39
    PlayAlertSound 5 225
    MinimapIcon 1 Purple Star
    PlayEffect Purple


# ===========================================================================
# ABSCHNITT 11: RESTLICHE CURRENCY  (Sicherheitsnetz - zeigt ALLES uebrige)
# Faengt jede Stackable Currency ab, die oben nicht spezifisch gestylt wurde
# ===========================================================================

Show
    Class "Stackable Currency"
    SetTextColor 200 200 200 255
    SetBackgroundColor 0 0 0 180
    SetBorderColor 140 140 140 200
    SetFontSize 30
    PlayAlertSound 3 150
    MinimapIcon 2 White Circle


# ===========================================================================
# ABSCHNITT 12: WAYSTONES  (Class "Waystones")
# ===========================================================================

# T11-T15: Hohe Tier Waystones
Show
    Class "Waystones"
    WaystoneTier >= 11
    SetTextColor 0 255 255 255
    SetBackgroundColor 0 50 70 255
    SetBorderColor 0 230 255 255
    SetFontSize 43
    PlayAlertSound 4 250
    MinimapIcon 0 Cyan Square
    PlayEffect Cyan

# T6-T10: Mittlere Tier Waystones
Show
    Class "Waystones"
    WaystoneTier >= 6
    SetTextColor 0 210 240 255
    SetBackgroundColor 0 30 50 240
    SetBorderColor 0 175 215 240
    SetFontSize 39
    PlayAlertSound 4 200
    MinimapIcon 1 Cyan Square
    PlayEffect Cyan

# T1-T5: Niedrige Tier Waystones (leise, kein Alarm)
Show
    Class "Waystones"
    SetTextColor 0 165 200 255
    SetBackgroundColor 0 12 28 200
    SetBorderColor 0 115 155 200
    SetFontSize 33


# ===========================================================================
# ABSCHNITT 13: TABLETS  (Precursor / Tablet - Atlas)
# ===========================================================================

Show
    Class "Tablet"
    SetTextColor 100 210 255 255
    SetBackgroundColor 0 38 70 225
    SetBorderColor 65 165 255 225
    SetFontSize 38
    PlayAlertSound 4 185
    MinimapIcon 1 Cyan Diamond
    PlayEffect Cyan


# ===========================================================================
# ABSCHNITT 14: GEMS  (Class "Gems")
# ===========================================================================

# Uncut Gems (Skill/Support/Spirit) - Hauptquelle fuer Gems, wertvoll
Show
    BaseType "Uncut Skill Gem" "Uncut Spirit Gem" "Uncut Support Gem"
    SetTextColor 26 230 26 255
    SetBackgroundColor 0 55 0 235
    SetBorderColor 0 230 0 255
    SetFontSize 40
    PlayAlertSound 5 250
    MinimapIcon 0 Green Circle
    PlayEffect Green

# Geschliffene Gems mit Qualitaet
Show
    Class "Gems"
    Quality >= 1
    SetTextColor 26 205 26 255
    SetBackgroundColor 0 38 0 205
    SetBorderColor 0 175 0 225
    SetFontSize 36
    PlayAlertSound 5 180
    MinimapIcon 1 Green Circle

# Alle anderen Gems
Show
    Class "Gems"
    SetTextColor 26 175 26 255
    SetBackgroundColor 0 25 0 185
    SetBorderColor 0 130 0 185
    SetFontSize 32
    MinimapIcon 2 Green Circle


# ===========================================================================
# ABSCHNITT 15: UNIQUE ITEMS  (immer anzeigen, alle Slots)
# ===========================================================================

Show
    Rarity Unique
    SetTextColor 175 96 37 255
    SetBackgroundColor 53 28 9 255
    SetBorderColor 175 96 37 255
    SetFontSize 43
    PlayAlertSound 3 260
    MinimapIcon 0 Brown Star
    PlayEffect Brown


# ===========================================================================
# ABSCHNITT 16: JEWELS  (Class "Jewels", nicht-unique)
# ===========================================================================

Show
    Class "Jewels"
    Rarity Rare
    SetTextColor 255 255 119 255
    SetBackgroundColor 40 35 0 225
    SetBorderColor 210 210 0 210
    SetFontSize 37
    PlayAlertSound 3 210
    MinimapIcon 1 Yellow Diamond
    PlayEffect Yellow

Show
    Class "Jewels"
    SetTextColor 180 180 200 220
    SetBackgroundColor 15 15 40 190
    SetBorderColor 90 90 130 190
    SetFontSize 30
    MinimapIcon 2 Blue Diamond


# ===========================================================================
# ABSCHNITT 17: CHARMS  (Class "Charms")
# ===========================================================================

# Seltene Charms
Show
    Class "Charms"
    Rarity Rare
    SetTextColor 255 255 119 230
    SetBackgroundColor 25 20 0 190
    SetBorderColor 150 145 0 190
    SetFontSize 32
    MinimapIcon 2 Yellow Circle

# Hochwertige Charms (Quality)
Show
    Class "Charms"
    Quality >= 10
    SetTextColor 205 205 205 255
    SetBackgroundColor 0 0 0 185
    SetFontSize 30

# Normale Charms ausblenden (Endgame)
Hide
    Class "Charms"
    Rarity Normal
    SetFontSize 16

# Verbleibende Charms (Magic) leise anzeigen
Show
    Class "Charms"
    SetTextColor 165 165 165 200
    SetFontSize 26


# ===========================================================================
# ABSCHNITT 18: EXPEDITION LOGBOOKS  (per BaseType erkannt)
# ===========================================================================

Show
    BaseType "Logbook"
    SetTextColor 205 165 60 255
    SetBackgroundColor 48 28 0 205
    SetBorderColor 165 115 0 205
    SetFontSize 38
    PlayAlertSound 3 185
    MinimapIcon 1 Brown Diamond
    PlayEffect Brown


# ===========================================================================
# ABSCHNITT 19: RELICS  (Trial of Sekhamas, per BaseType erkannt)
# ===========================================================================

Show
    BaseType "Relic"
    SetTextColor 220 190 130 255
    SetBackgroundColor 45 30 10 215
    SetBorderColor 175 140 80 215
    SetFontSize 36
    PlayAlertSound 3 180
    MinimapIcon 2 Brown Diamond


# ===========================================================================
# ABSCHNITT 20: RARE ITEMS  (Endgame-Bases nach ItemLevel)
# ===========================================================================

# Hohe ilvl Rares (75+): Immer anzeigen
Show
    Rarity Rare
    ItemLevel >= 75
    SetTextColor 255 255 119 255
    SetBackgroundColor 30 26 0 215
    SetBorderColor 165 160 0 215
    SetFontSize 33
    MinimapIcon 2 Yellow Circle

# Mittlere ilvl Rares (60-74)
Show
    Rarity Rare
    ItemLevel >= 60
    SetTextColor 220 215 90 220
    SetBackgroundColor 20 18 0 190
    SetBorderColor 130 125 0 190
    SetFontSize 30

# Niedrige ilvl Rares: Ausblenden im Endgame
Hide
    Rarity Rare
    SetFontSize 18


# ===========================================================================
# ABSCHNITT 21: MAGIC ITEMS  (groesstenteils ausblenden)
# ===========================================================================

# Magic Items mit sehr hoher ilvl (Endgame Craft-Bases)
Show
    Rarity Magic
    ItemLevel >= 82
    SetTextColor 95 95 200 195
    SetBorderColor 70 70 175 175
    SetFontSize 22

# Alle anderen Magic Items ausblenden
Hide
    Rarity Magic
    SetFontSize 14


# ===========================================================================
# ABSCHNITT 22: NORMALE (WEISSE) ITEMS  (alle ausblenden)
# ===========================================================================

Hide
    Rarity Normal
    SetFontSize 12


# ===========================================================================
# CATCH-ALL: Alles nicht gefilterte ausblenden
# ===========================================================================

Hide
    SetFontSize 12


# ===========================================================================
# END OF FILTER
# poe2-endgame-strict.filter  |  v1.2
# ===========================================================================
