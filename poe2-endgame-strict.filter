# ===========================================================================
# POE2 ENDGAME STRICT LOOT FILTER
# Version: 1.1  |  Schwierigkeit: Strikt (Endgame)
# Optimiert fuer: Endgame-Farming, hohe Waystone-Tier-Gebiete
#
# FARBCODE:
#   Rot/Pink    = Mirror-Tier / Ultra-Selten
#   Gold/Gelb   = Hohe Currency (Divine, Exalted)
#   Orange      = Mittlere Currency (Chaos, Regal)
#   Tuerkis     = Waystones
#   Gruen       = Gems
#   Braun       = Unique Items
#   Lila/Pink   = Essences / Soul Cores / Runes
#   Blau        = Delirium / Distilled
#   Gelb (rand) = Rare Items (hohe ilvl)
#
# HINWEIS: Filter-Klassennamen basieren auf PoE2 Early Access.
#          Bei Updates ggf. Class-Namen anpassen.
# ===========================================================================


# ===========================================================================
# ABSCHNITT 1: MIRROR TIER  (Extrem selten)
# ===========================================================================

Show
    Class "Currency"
    BaseType "Mirror of Kalandra" "Mirror Shard"
    SetTextColor 255 0 0 255
    SetBackgroundColor 0 0 0 255
    SetBorderColor 255 0 0 255
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Red Star
    PlayEffect Red


# ===========================================================================
# ABSCHNITT 2: TOP CURRENCY  (Divine / Exalted)
# ===========================================================================

Show
    Class "Currency"
    BaseType "Divine Orb"
    SetTextColor 255 215 0 255
    SetBackgroundColor 60 40 0 255
    SetBorderColor 255 200 0 255
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Yellow Star
    PlayEffect Yellow

Show
    Class "Currency"
    BaseType "Exalted Orb"
    SetTextColor 255 210 0 255
    SetBackgroundColor 50 30 0 255
    SetBorderColor 220 175 0 255
    SetFontSize 43
    PlayAlertSound 1 300
    MinimapIcon 0 Yellow Star
    PlayEffect Yellow


# ===========================================================================
# ABSCHNITT 3: HOHE CURRENCY
# ===========================================================================

Show
    Class "Currency"
    BaseType "Chaos Orb" "Regal Orb" "Orb of Annulment" "Orb of Unmaking"
    SetTextColor 255 165 0 255
    SetBackgroundColor 50 15 0 255
    SetBorderColor 220 130 0 255
    SetFontSize 40
    PlayAlertSound 2 300
    MinimapIcon 1 Orange Diamond
    PlayEffect Orange

Show
    Class "Currency"
    BaseType "Vaal Orb" "Ancient Orb" "Gemcutter's Prism" "Orb of Horizons" "Perfect Jeweller's Orb" "Greater Jeweller's Orb"
    SetTextColor 230 150 0 255
    SetBackgroundColor 40 10 0 220
    SetBorderColor 190 110 0 220
    SetFontSize 38
    PlayAlertSound 2 250
    MinimapIcon 1 Yellow Diamond
    PlayEffect Yellow


# ===========================================================================
# ABSCHNITT 4: MITTLERE CURRENCY
# ===========================================================================

Show
    Class "Currency"
    BaseType "Orb of Alchemy" "Orb of Alteration" "Blessed Orb" "Orb of Chance" "Orb of Binding"
    SetTextColor 200 180 0 255
    SetBackgroundColor 0 0 0 200
    SetBorderColor 150 130 0 220
    SetFontSize 35
    PlayAlertSound 3 200
    MinimapIcon 2 Yellow Circle

Show
    Class "Currency"
    BaseType "Blacksmith's Whetstone" "Armourer's Scrap" "Orb of Transmutation" "Orb of Augmentation" "Artificer's Orb" "Glassblower's Bauble"
    SetTextColor 170 170 170 255
    SetBackgroundColor 0 0 0 180
    SetBorderColor 100 100 100 200
    SetFontSize 30
    MinimapIcon 2 Grey Circle


# ===========================================================================
# ABSCHNITT 5: NIEDRIGE CURRENCY  (Im Endgame ausblenden)
# ===========================================================================

Hide
    Class "Currency"
    BaseType "Scroll of Wisdom" "Portal Scroll"
    SetTextColor 70 70 70 120
    SetFontSize 16

# Sicherheitsnetz: alle verbleibenden Currency anzeigen
Show
    Class "Currency"
    SetTextColor 200 200 200 255
    SetBackgroundColor 0 0 0 180
    SetBorderColor 140 140 140 200
    SetFontSize 30
    PlayAlertSound 3 150
    MinimapIcon 2 White Circle


# ===========================================================================
# ABSCHNITT 6: STACKABLE CURRENCY  (Splitter, Katalysatoren, etc.)
# ===========================================================================

Show
    Class "Stackable Currency"
    BaseType "Breachstone"
    SetTextColor 255 120 0 255
    SetBackgroundColor 55 15 0 220
    SetBorderColor 220 80 0 255
    SetFontSize 38
    PlayAlertSound 2 220
    MinimapIcon 1 Orange Star
    PlayEffect Orange

Show
    Class "Stackable Currency"
    BaseType "Splinter"
    SetTextColor 255 150 0 255
    SetBackgroundColor 45 12 0 200
    SetBorderColor 200 100 0 220
    SetFontSize 32
    MinimapIcon 2 Orange Circle

# Verbleibende Stackable Currency
Show
    Class "Stackable Currency"
    SetTextColor 200 190 140 255
    SetBackgroundColor 0 0 0 160
    SetFontSize 30
    MinimapIcon 2 White Circle


# ===========================================================================
# ABSCHNITT 7: WAYSTONES (Karten-Aequivalent)
# ===========================================================================

# T11-T15: Hohe Tier Waystones
Show
    Class "Waystone"
    WaystoneTier >= 11
    SetTextColor 0 255 255 255
    SetBackgroundColor 0 50 70 255
    SetBorderColor 0 230 255 255
    SetFontSize 43
    PlayAlertSound 4 250
    MinimapIcon 0 Cyan Square
    PlayEffect Cyan

# T6-T10: Mittlere Tier Waystones
Show
    Class "Waystone"
    WaystoneTier >= 6
    SetTextColor 0 210 240 255
    SetBackgroundColor 0 30 50 240
    SetBorderColor 0 175 215 240
    SetFontSize 39
    PlayAlertSound 4 200
    MinimapIcon 1 Cyan Square
    PlayEffect Cyan

# T1-T5: Niedrige Tier Waystones (leise)
Show
    Class "Waystone"
    SetTextColor 0 165 200 255
    SetBackgroundColor 0 12 28 200
    SetBorderColor 0 115 155 200
    SetFontSize 33


# ===========================================================================
# ABSCHNITT 8: GEMS (Skill & Support)
# ===========================================================================

# Hohe Qualitaet Gems (14%+) - Sehr wertvoll
Show
    Class "Skill Gem" "Support Gem" "Gem"
    Quality >= 14
    SetTextColor 26 230 26 255
    SetBackgroundColor 0 55 0 235
    SetBorderColor 0 230 0 255
    SetFontSize 42
    PlayAlertSound 5 250
    MinimapIcon 0 Green Circle
    PlayEffect Green

# Mittlere Qualitaet Gems (7-13%)
Show
    Class "Skill Gem" "Support Gem" "Gem"
    Quality >= 7
    SetTextColor 26 205 26 255
    SetBackgroundColor 0 38 0 205
    SetBorderColor 0 175 0 225
    SetFontSize 36
    PlayAlertSound 5 180
    MinimapIcon 1 Green Circle

# Alle anderen Gems
Show
    Class "Skill Gem" "Support Gem" "Gem"
    SetTextColor 26 175 26 255
    SetBackgroundColor 0 25 0 185
    SetBorderColor 0 130 0 185
    SetFontSize 30
    MinimapIcon 2 Green Circle


# ===========================================================================
# ABSCHNITT 9: UNIQUE ITEMS  (immer anzeigen)
# ===========================================================================

Show
    Rarity Unique
    SetTextColor 175 96 37 255
    SetBackgroundColor 53 28 9 255
    SetBorderColor 175 96 37 255
    SetFontSize 43
    PlayAlertSound 3 260
    MinimapIcon 0 Brown Star
    PlayEffect Brown


# ===========================================================================
# ABSCHNITT 10: JEWELS
# ===========================================================================

# Rare Jewels
Show
    Class "Jewel"
    Rarity Rare
    SetTextColor 255 255 119 255
    SetBackgroundColor 40 35 0 225
    SetBorderColor 210 210 0 210
    SetFontSize 37
    PlayAlertSound 3 210
    MinimapIcon 1 Yellow Diamond
    PlayEffect Yellow

Show
    Class "Jewel"
    Rarity Magic
    SetTextColor 140 140 255 220
    SetBackgroundColor 15 15 40 190
    SetFontSize 28
    MinimapIcon 2 Blue Diamond

Show
    Class "Jewel"
    SetTextColor 180 180 180 200
    SetBackgroundColor 15 15 15 170
    SetFontSize 26
    MinimapIcon 2 Grey Diamond


# ===========================================================================
# ABSCHNITT 11: ESSENCES
# ===========================================================================

Show
    Class "Essence"
    SetTextColor 255 100 255 255
    SetBackgroundColor 60 0 65 225
    SetBorderColor 225 0 225 255
    SetFontSize 39
    PlayAlertSound 3 225
    MinimapIcon 0 Purple Diamond
    PlayEffect Purple


# ===========================================================================
# ABSCHNITT 12: RUNES  (Socket-Items)
# ===========================================================================

Show
    Class "Rune"
    SetTextColor 200 170 255 255
    SetBackgroundColor 35 0 60 205
    SetBorderColor 160 100 255 225
    SetFontSize 33
    MinimapIcon 2 Purple Circle


# ===========================================================================
# ABSCHNITT 13: SOUL CORES
# ===========================================================================

Show
    Class "Soul Core"
    SetTextColor 255 180 255 255
    SetBackgroundColor 60 0 65 235
    SetBorderColor 255 100 255 255
    SetFontSize 39
    PlayAlertSound 5 225
    MinimapIcon 1 Purple Star
    PlayEffect Purple


# ===========================================================================
# ABSCHNITT 14: BREACH ITEMS
# ===========================================================================

# Breach Ringe
Show
    Class "Ring"
    BaseType "Breach Ring"
    SetTextColor 255 120 0 255
    SetBackgroundColor 60 20 0 225
    SetBorderColor 225 80 0 255
    SetFontSize 37
    PlayAlertSound 3 205
    MinimapIcon 1 Orange Diamond
    PlayEffect Orange

# Breach Splitter (via BaseType da Class unsicher)
Show
    BaseType "Splinter of Xoph" "Splinter of Tul" "Splinter of Esh" "Splinter of Uul-Netol" "Splinter of Chayula"
    SetTextColor 255 145 0 255
    SetBackgroundColor 50 15 0 205
    SetBorderColor 205 95 0 205
    SetFontSize 33
    MinimapIcon 2 Orange Circle


# ===========================================================================
# ABSCHNITT 15: DELIRIUM / DISTILLED EMOTIONS
# ===========================================================================

# Hohe Distilled Emotions
Show
    BaseType "Distilled Despair" "Distilled Fear" "Distilled Guilt" "Distilled Envy" "Distilled Ire"
    SetTextColor 200 190 255 255
    SetBackgroundColor 25 20 75 225
    SetBorderColor 140 130 255 235
    SetFontSize 37
    PlayAlertSound 3 190
    MinimapIcon 1 Blue Diamond
    PlayEffect Blue

# Andere Distilled Emotions
Show
    BaseType "Distilled Isolation" "Distilled Paranoia" "Distilled Suffering" "Distilled Disgust" "Distilled Greed"
    SetTextColor 170 165 240 255
    SetBackgroundColor 18 15 60 205
    SetBorderColor 115 110 225 210
    SetFontSize 33
    MinimapIcon 2 Blue Circle
    PlayEffect Blue

# Alle anderen Distilled (Sicherheitsnetz)
Show
    BaseType "Distilled"
    SetTextColor 150 145 215 220
    SetBackgroundColor 12 10 50 190
    SetBorderColor 95 90 195 195
    SetFontSize 30
    MinimapIcon 2 Blue Circle


# ===========================================================================
# ABSCHNITT 16: CHARMS  (Kolben-Ersatz in PoE2)
# ===========================================================================

# Hochwertige Charms
Show
    Class "Charm"
    Quality >= 10
    SetTextColor 205 205 205 255
    SetBackgroundColor 0 0 0 185
    SetFontSize 30
    MinimapIcon 2 White Circle

# Seltene Charms
Show
    Class "Charm"
    Rarity Rare
    SetTextColor 255 255 119 220
    SetBackgroundColor 20 15 0 180
    SetFontSize 28

# Normale Charms ausblenden (Endgame)
Hide
    Class "Charm"
    Rarity Normal
    SetFontSize 16

# Verbleibende Charms
Show
    Class "Charm"
    SetTextColor 165 165 165 200
    SetFontSize 25


# ===========================================================================
# ABSCHNITT 17: PRECURSOR TABLETS
# ===========================================================================

Show
    Class "Tablet"
    SetTextColor 100 210 255 255
    SetBackgroundColor 0 38 70 225
    SetBorderColor 65 165 255 225
    SetFontSize 38
    PlayAlertSound 4 185
    MinimapIcon 1 Cyan Diamond
    PlayEffect Cyan


# ===========================================================================
# ABSCHNITT 18: EXPEDITION LOGBOOKS
# ===========================================================================

Show
    Class "Logbook"
    SetTextColor 205 165 60 255
    SetBackgroundColor 48 28 0 205
    SetBorderColor 165 115 0 205
    SetFontSize 36
    PlayAlertSound 3 185
    MinimapIcon 1 Brown Diamond


# ===========================================================================
# ABSCHNITT 19: RARE ITEMS  (Endgame-Bases)
# ===========================================================================

# Hohe ilvl Rares (75+): Immer anzeigen
Show
    Rarity Rare
    ItemLevel >= 75
    SetTextColor 255 255 119 255
    SetBackgroundColor 30 26 0 215
    SetBorderColor 165 160 0 215
    SetFontSize 33
    MinimapIcon 2 Yellow Circle

# Mittlere ilvl Rares (60-74)
Show
    Rarity Rare
    ItemLevel >= 60
    SetTextColor 220 215 90 220
    SetBackgroundColor 20 18 0 190
    SetBorderColor 130 125 0 190
    SetFontSize 30

# Niedrige ilvl Rares: Ausblenden im Endgame
Hide
    Rarity Rare
    ItemLevel < 60
    SetTextColor 100 95 40 130
    SetFontSize 20


# ===========================================================================
# ABSCHNITT 20: MAGIC ITEMS  (groesstenteils ausblenden)
# ===========================================================================

# Magic Jewels immer anzeigen
Show
    Class "Jewel"
    Rarity Magic
    SetTextColor 140 140 255 225
    SetFontSize 28

# Magic Items mit sehr hoher ilvl (Endgame Craft-Bases)
Show
    Rarity Magic
    ItemLevel >= 82
    SetTextColor 95 95 200 195
    SetBorderColor 70 70 175 175
    SetFontSize 22

# Alle anderen Magic Items ausblenden
Hide
    Rarity Magic
    SetFontSize 14
    SetTextColor 50 50 110 90


# ===========================================================================
# ABSCHNITT 21: NORMALE (WEISSE) ITEMS  (alle ausblenden)
# ===========================================================================

Hide
    Rarity Normal
    SetFontSize 12
    SetTextColor 40 40 40 70


# ===========================================================================
# CATCH-ALL: Alles nicht gefilterte ausblenden
# ===========================================================================

Hide
    SetFontSize 12
    SetTextColor 40 40 40 60


# ===========================================================================
# END OF FILTER
# poe2-endgame-strict.filter  |  v1.1
# ===========================================================================
