# ===========================================================================
# POE2 ENDGAME STRICT LOOT FILTER
# Version: 1.5  |  Schwierigkeit: Strikt (Endgame)
# Patch: 0.5.x "Return of the Ancients"
#
# DESIGN-PRINZIP (PoE2 validiert STRENG - ein ungueltiger Name bricht den
# GANZEN Filter ab):
#   - NUR EINE Klasse wird genutzt: "Stackable Currency" (in-game verifiziert)
#   - Alle anderen Item-Typen werden ueber BaseType-Stems erkannt, die
#     garantiert echte 0.5.x-Bases treffen:
#       "Essence", "Omen", "Liquid" (Delirium, frueher "Distilled"),
#       "Uncut", "Rune", "Soul Core", "Idol", "Waystone", "Tablet",
#       "Charm", "Logbook"
#   - Currency-BaseTypes gegen poe2db verifiziert
#   - Gear/Jewels/Relics laufen ueber Rarity-Regeln
#
# SOUND-SCHEMA:
#   Kein Sound  = Gold (Top Currency), Runes, niedrige Stackable Currency,
#                 Waystones T6-T10
#   Sound 6 300 = Mirror / Hinekora's Lock (Chase)
#   Sound 1 250 = Hohe Currency (Exalted, Chaos, Annulment usw.)
#   Sound 2 180 = Mittlere Currency
#   Sound 5 250 = Uncut Gems  (hohe Prioritaet)
#   Sound 5 220 = Essences
#   Sound 5 200 = Omens / Soul Cores
#   Sound 3 180 = Idols / Logbooks
#   Sound 3 160 = Liquid Emotions / Tablets
#   Sound 4 250 = Waystones T11+
#   Sound 3 260 = Unique Items
#
# FARBCODE:
#   Rot     = Mirror / Hinekora's Lock (Chase)
#   Gold    = Top-Currency           Orange = Hohe Currency
#   Gelb    = Mittlere Currency       Pink   = Essences / Omens
#   Blau    = Liquid Emotions         Gruen  = Uncut Gems / Idols
#   Lila    = Runes / Soul Cores      Tuerkis= Waystones / Tablets
#   Braun   = Uniques / Logbooks      Gelb(rand) = Rare Items (hohe ilvl)
# ===========================================================================


# ===========================================================================
# ABSCHNITT 1: CHASE / MIRROR TIER
# ===========================================================================

Show
    BaseType "Mirror of Kalandra" "Hinekora's Lock"
    SetTextColor 255 0 0 255
    SetBackgroundColor 0 0 0 255
    SetBorderColor 255 0 0 255
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Red Star
    PlayEffect Red


# ===========================================================================
# ABSCHNITT 2: TOP CURRENCY  (kein Sound - damit es nicht nervt beim farmen)
# ===========================================================================

Show
    BaseType "Divine Orb" "Perfect Jeweller's Orb" "Perfect Exalted Orb" "Perfect Chaos Orb" "Perfect Regal Orb"
    SetTextColor 255 215 0 255
    SetBackgroundColor 60 40 0 255
    SetBorderColor 255 200 0 255
    SetFontSize 45
    MinimapIcon 0 Yellow Star
    PlayEffect Yellow


# ===========================================================================
# ABSCHNITT 3: HOHE CURRENCY
# ===========================================================================

Show
    BaseType "Exalted Orb" "Chaos Orb" "Orb of Annulment" "Vaal Orb" "Fracturing Orb" "Gemcutter's Prism" "Greater Jeweller's Orb" "Greater Exalted Orb" "Greater Chaos Orb" "Greater Regal Orb"
    SetTextColor 255 165 0 255
    SetBackgroundColor 50 15 0 255
    SetBorderColor 220 130 0 255
    SetFontSize 40
    PlayAlertSound 1 250
    MinimapIcon 1 Orange Diamond
    PlayEffect Orange


# ===========================================================================
# ABSCHNITT 4: MITTLERE CURRENCY
# ===========================================================================

Show
    BaseType "Regal Orb" "Orb of Alchemy" "Orb of Chance" "Lesser Jeweller's Orb" "Artificer's Orb" "Arcanist's Etcher" "Greater Orb of Transmutation" "Perfect Orb of Transmutation" "Greater Orb of Augmentation" "Perfect Orb of Augmentation"
    SetTextColor 230 180 70 255
    SetBackgroundColor 40 25 0 220
    SetBorderColor 180 130 50 220
    SetFontSize 36
    PlayAlertSound 2 180
    MinimapIcon 2 Yellow Circle


# ===========================================================================
# ABSCHNITT 5: ESSENCES
# ===========================================================================

Show
    BaseType "Essence"
    SetTextColor 255 100 255 255
    SetBackgroundColor 60 0 65 225
    SetBorderColor 225 0 225 255
    SetFontSize 39
    PlayAlertSound 5 220
    MinimapIcon 0 Pink Diamond
    PlayEffect Pink


# ===========================================================================
# ABSCHNITT 6: OMENS  (Ritual)
# ===========================================================================

Show
    BaseType "Omen"
    SetTextColor 255 140 200 255
    SetBackgroundColor 55 10 35 225
    SetBorderColor 230 90 160 255
    SetFontSize 39
    PlayAlertSound 5 200
    MinimapIcon 0 Pink Star
    PlayEffect Pink


# ===========================================================================
# ABSCHNITT 7: LIQUID EMOTIONS  (Delirium)
# ===========================================================================

Show
    BaseType "Liquid"
    SetTextColor 180 175 255 255
    SetBackgroundColor 20 16 65 225
    SetBorderColor 120 110 235 235
    SetFontSize 37
    PlayAlertSound 3 160
    MinimapIcon 1 Blue Diamond
    PlayEffect Blue


# ===========================================================================
# ABSCHNITT 8: UNCUT GEMS  (Skill / Support / Spirit)
# ===========================================================================

Show
    BaseType "Uncut"
    SetTextColor 26 230 26 255
    SetBackgroundColor 0 55 0 235
    SetBorderColor 0 230 0 255
    SetFontSize 40
    PlayAlertSound 5 250
    MinimapIcon 0 Green Circle
    PlayEffect Green


# ===========================================================================
# ABSCHNITT 9: RUNES  (kein Sound - fallen sehr haeufig)
# ===========================================================================

Show
    BaseType "Rune"
    SetTextColor 200 170 255 255
    SetBackgroundColor 35 0 60 215
    SetBorderColor 160 100 255 235
    SetFontSize 35
    MinimapIcon 2 Purple Circle
    PlayEffect Purple


# ===========================================================================
# ABSCHNITT 10: SOUL CORES
# ===========================================================================

Show
    BaseType "Soul Core"
    SetTextColor 255 180 255 255
    SetBackgroundColor 60 0 65 235
    SetBorderColor 255 100 255 255
    SetFontSize 39
    PlayAlertSound 5 200
    MinimapIcon 1 Purple Star
    PlayEffect Purple


# ===========================================================================
# ABSCHNITT 11: IDOLS  (neu in 0.5.0, socketbar in Gear)
# ===========================================================================

Show
    BaseType "Idol"
    SetTextColor 150 255 170 255
    SetBackgroundColor 10 45 20 230
    SetBorderColor 90 220 130 240
    SetFontSize 38
    PlayAlertSound 3 180
    MinimapIcon 1 Green Hexagon
    PlayEffect Green


# ===========================================================================
# ABSCHNITT 12: RESTLICHE CURRENCY  (kein Sound - Shards, Whetstones, usw.)
# Faengt jede Stackable Currency ab, die oben nicht spezifisch gestylt wurde
# ===========================================================================

Show
    Class "Stackable Currency"
    SetTextColor 200 200 200 255
    SetBackgroundColor 0 0 0 180
    SetBorderColor 140 140 140 200
    SetFontSize 30
    MinimapIcon 2 White Circle


# ===========================================================================
# ABSCHNITT 13: WAYSTONES
# ===========================================================================

# T11-T15: Hohe Tier Waystones
Show
    BaseType "Waystone"
    WaystoneTier >= 11
    SetTextColor 0 255 255 255
    SetBackgroundColor 0 50 70 255
    SetBorderColor 0 230 255 255
    SetFontSize 43
    PlayAlertSound 4 250
    MinimapIcon 0 Cyan Square
    PlayEffect Cyan

# T6-T10: Mittlere Tier Waystones (kein Sound)
Show
    BaseType "Waystone"
    WaystoneTier >= 6
    SetTextColor 0 210 240 255
    SetBackgroundColor 0 30 50 240
    SetBorderColor 0 175 215 240
    SetFontSize 39
    MinimapIcon 1 Cyan Square
    PlayEffect Cyan

# T1-T5: Niedrige Tier Waystones (leise, kein Alarm)
Show
    BaseType "Waystone"
    SetTextColor 0 165 200 255
    SetBackgroundColor 0 12 28 200
    SetBorderColor 0 115 155 200
    SetFontSize 33


# ===========================================================================
# ABSCHNITT 14: TABLETS  (Precursor / Atlas)
# ===========================================================================

Show
    BaseType "Tablet"
    SetTextColor 100 210 255 255
    SetBackgroundColor 0 38 70 225
    SetBorderColor 65 165 255 225
    SetFontSize 38
    PlayAlertSound 4 160
    MinimapIcon 1 Cyan Diamond
    PlayEffect Cyan


# ===========================================================================
# ABSCHNITT 15: CHARMS  (Guertel-Slot)
# ===========================================================================

# Seltene Charms
Show
    BaseType "Charm"
    Rarity Rare
    SetTextColor 255 255 119 230
    SetBackgroundColor 25 20 0 190
    SetBorderColor 150 145 0 190
    SetFontSize 32
    MinimapIcon 2 Yellow Circle

# Normale Charms ausblenden (Endgame)
Hide
    BaseType "Charm"
    Rarity Normal
    SetFontSize 16

# Verbleibende Charms (Magic) leise anzeigen
Show
    BaseType "Charm"
    SetTextColor 165 165 165 200
    SetFontSize 26


# ===========================================================================
# ABSCHNITT 16: EXPEDITION LOGBOOKS  (0.5.0 Ocean-Mechanik)
# ===========================================================================

Show
    BaseType "Logbook"
    SetTextColor 205 165 60 255
    SetBackgroundColor 48 28 0 205
    SetBorderColor 165 115 0 205
    SetFontSize 38
    PlayAlertSound 3 180
    MinimapIcon 1 Brown Diamond
    PlayEffect Brown


# ===========================================================================
# ABSCHNITT 17: UNIQUE ITEMS  (immer anzeigen - inkl. Unique Jewels/Relics)
# ===========================================================================

Show
    Rarity Unique
    SetTextColor 175 96 37 255
    SetBackgroundColor 53 28 9 255
    SetBorderColor 175 96 37 255
    SetFontSize 43
    PlayAlertSound 3 260
    MinimapIcon 0 Brown Star
    PlayEffect Brown


# ===========================================================================
# ABSCHNITT 18: RARE ITEMS  (Endgame-Bases nach ItemLevel - inkl. Jewels)
# ===========================================================================

# Hohe ilvl Rares (75+): Immer anzeigen
Show
    Rarity Rare
    ItemLevel >= 75
    SetTextColor 255 255 119 255
    SetBackgroundColor 30 26 0 215
    SetBorderColor 165 160 0 215
    SetFontSize 33
    MinimapIcon 2 Yellow Circle

# Mittlere ilvl Rares (60-74)
Show
    Rarity Rare
    ItemLevel >= 60
    SetTextColor 220 215 90 220
    SetBackgroundColor 20 18 0 190
    SetBorderColor 130 125 0 190
    SetFontSize 30

# Niedrige ilvl Rares: Ausblenden im Endgame
Hide
    Rarity Rare
    SetFontSize 18


# ===========================================================================
# ABSCHNITT 19: MAGIC ITEMS  (groesstenteils ausblenden)
# ===========================================================================

# Magic Items mit sehr hoher ilvl (Endgame Craft-Bases)
Show
    Rarity Magic
    ItemLevel >= 82
    SetTextColor 95 95 200 195
    SetBorderColor 70 70 175 175
    SetFontSize 22

# Alle anderen Magic Items ausblenden
Hide
    Rarity Magic
    SetFontSize 14


# ===========================================================================
# ABSCHNITT 20: NORMALE (WEISSE) ITEMS  (alle ausblenden)
# ===========================================================================

Hide
    Rarity Normal
    SetFontSize 12


# ===========================================================================
# CATCH-ALL: Alles nicht gefilterte ausblenden
# ===========================================================================

Hide
    SetFontSize 12


# ===========================================================================
# END OF FILTER
# poe2-endgame-strict.filter  |  v1.5
# ===========================================================================
